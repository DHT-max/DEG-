# BiocManager::install("GEOquery")
library(GEOquery)
library(tidyverse)
setwd('D:/MDD/') #设环境
gset <- getGEO("GSE98793", destdir = ".", AnnotGPL = F, getGPL = F)
View(gset)
class(gset)
gset[[1]] #查看信息
#提取基因表达数据
exp <- exprs(gset[[1]])
#1.标准化####
boxplot(exp, outline=F,las=2)
library(limma)
exp=normalizeBetweenArrays(exp)
boxplot(exp, outline=F,las=2)
View(exp)
#2.归一化####
range(exp)#查看range范围，如果数值过大，需要归一化，log2处理
#exp <- log2(exp+1) #如果数值过大，需要归一化，用log2处理
#3.基因注释，GPL导入####
gpl<-read.table('GPL570-55999.txt',header=TRUE,fill=T,sep='\t',comment.char ='#',stringsAsFactors = F
quote='') #去掉前几列没用的行
#exp <- log2(exp+1) #如果数值过大，需要归一化，用log2处理
#3.基因注释，GPL导入####
gpl<-read.table('GPL570-55999.txt',header=TRUE,fill=T,sep='\t',comment.char ='#',stringsAsFactors = F
quote='') #去掉前几列没用的行
#exp <- log2(exp+1) #如果数值过大，需要归一化，用log2处理
#3.基因注释，GPL导入####
gpl<-read.table('GPL570-55999.txt',header=TRUE,fill=T,sep='\t',comment.char ='#',stringsAsFactors = F ,
quote='') #去掉前几列没用的行
View(gpl)
colnames(gpl) #查看列名
ids <- gpl[,c('ID','Gene.Symbol')] #需要查看表格填写正确的列
View(ids)
colnames(ids) <- c('probe_id','symbol') #重命名
ids$symbol <- trimws(str_split(ids$symbol,'///',simplify = T))
ids <- ids[ids$symbol!='',]#删除空白
ids <- ids[ids$symbol!='---',]#删除空白
library(stringr)
ids$symbol <- trimws(str_split(ids$symbol,'///',simplify = T))
ids <- gpl[,c('ID','Gene.Symbol')] #需要查看表格填写正确的列
colnames(ids) <- c('probe_id','symbol') #重命名
ids$symbol <- trimws(str_split(ids$symbol,'///',simplify = T)[,1])
ids <- ids[ids$symbol!='',]#删除空白
ids <- ids[ids$symbol!='---',]#删除空白
ids <- ids[ids$symbol!='--- ',]#删除空白
ids <- ids[ids$probe_id %in% rownames(exp),]
exp2 <- exp[ids$probe_id,]
table(rownames(exp2)==ids$probe_id)#确认
exp3 <- cbind(ids,exp2)
View(exp3)
#4.基因去重####
exp3 <- aggregate( . ~ symbol,exp3,max) #max最大，或者mean平
rownames(exp3) <- exp3$symbol
exp3 <- exp3[,-c(1,2)]
#5.获取临床数据####
rt1 <- pData(gset[[1]])
#保存总临床数据表
write.csv(rt1, file='GSE299988_cli.csv',row.names = T)
#对样本进行分组
#1.疾病分组
colnames(rt1)
View(rt1)
group_list <- ifelse(str_detect(rt1$`tissue types:characteristics_ch1`, "control"),"Normal","MDD")
group_list
group_list <- ifelse(str_detect(rt1$`tissue types:ch1`, "control"),"Normal","MDD")
group_list
group_list <- ifelse(str_detect(rt1$`characteristics_ch1`, "control"),"Normal","MDD")
group_list
rt1$group <- group_list
rt2 <- rt1 %>% dplyr::select("group")
#2.分组排列
rt3 <- rt2 %>% arrange(rt2)
View(rt3)
rt3 <- rt2 %>% arrange(desc(group))
#6.数据保存####
#exp3和rt3 列行一一对应
exp3 <- exp3[,rownames(rt3)]
identical(rownames(rt3),colnames(exp3))
View(exp3)
View(exp3)
View(exp3)
# [1] TRUE
#数据保存
save(rt3,exp3,file = "GSE299988.rda")
#确认
rm(list=ls())
load( "GSE299988.rda")
#二、limma差异分析####
library(pheatmap)
library(ggpubr)
rt <- rt3
exp <- exp3
str(exp)
exp <- exp %>% mutate(across(everything(), as.numeric))
str(exp)
#确认行名列名一致#确认行名列名一致exp33
identical(rownames(rt),colnames(exp))
#1.火山图####
group_list <- factor(rt$group,levels = c("Normal","Tumor"))
group_list
#1.火山图####
group_list <- factor(rt$group,levels = c("Normal","MDD"))
group_list
design <- model.matrix(~group_list)
#比较矩阵命名
design
#线性模型拟合
fit <- lmFit(exp,design)
#贝叶斯检验
fit2 <- eBayes(fit)
deg <- topTable(fit2, coef = 2, number = Inf)
#进行注释 fold change
#通常logFC设置1,adj.P.Val < 0.05
logFC_cutoff <- 1
type1 = (DEG$adj.P.Val < 0.05)&(DEG$logFC < -logFC_cutoff)
type2 = (DEG$adj.P.Val < 0.05)&(DEG$logFC > logFC_cutoff)
DEG = na.omit(deg) #differently expressed genes
#进行注释 fold change
#通常logFC设置1,adj.P.Val < 0.05
logFC_cutoff <- 1
type1 = (DEG$adj.P.Val < 0.05)&(DEG$logFC < -logFC_cutoff)
type2 = (DEG$adj.P.Val < 0.05)&(DEG$logFC > logFC_cutoff)
DEG$change = ifelse(type1,"DOWN",ifelse(type2,"UP","NOT"))
table(DEG$change)
View(DEG)
View(DEG)
#进行注释 fold change
#通常logFC设置1,adj.P.Val < 0.05
logFC_cutoff <- 0.5
type1 = (DEG$adj.P.Val < 0.05)&(DEG$logFC < -logFC_cutoff)
type2 = (DEG$adj.P.Val < 0.05)&(DEG$logFC > logFC_cutoff)
DEG$change = ifelse(type1,"DOWN",ifelse(type2,"UP","NOT"))
table(DEG$change)
#进行注释 fold change
#通常logFC设置1,adj.P.Val < 0.05
logFC_cutoff <- 0
type1 = (DEG$adj.P.Val < 0.05)&(DEG$logFC < -logFC_cutoff)
type2 = (DEG$adj.P.Val < 0.05)&(DEG$logFC > logFC_cutoff)
DEG$change = ifelse(type1,"DOWN",ifelse(type2,"UP","NOT"))
table(DEG$change)
#进行注释 fold change
#通常logFC设置1,adj.P.Val < 0.05
logFC_cutoff <- 0.1
type1 = (DEG$adj.P.Val < 0.05)&(DEG$logFC < -logFC_cutoff)
type2 = (DEG$adj.P.Val < 0.05)&(DEG$logFC > logFC_cutoff)
